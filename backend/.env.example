# Supabase PostgreSQL — dùng Connection Pooler, cổng 6543
DATABASE_URL=postgresql://user:password@host.pooler.supabase.com:6543/postgres

# Session cookie signing key — chuỗi ngẫu nhiên dài
SESSION_SECRET=your-random-secret-here

# Tài khoản 1
ADMIN1_USER=ten1
ADMIN1_PASS_HASH=$2b$12$...

# Tài khoản 2
ADMIN2_USER=ten2
ADMIN2_PASS_HASH=$2b$12$...
